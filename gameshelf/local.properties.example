# Copy this file to local.properties and fill in real values.
# Spring Boot (dev profile) imports local.properties automatically via application-dev.properties.
# Never commit local.properties — it is gitignored.

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev defaults; DB_URL and DB_USERNAME can be omitted to use the built-in defaults.
DB_URL=jdbc:postgresql://localhost:5432/gameshelf
DB_USERNAME=postgres
DB_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# ── IGDB (game data) ──────────────────────────────────────────────────────────
# Register at https://dev.twitch.tv — register an app under the IGDB category.
# The app fetches and auto-refreshes the OAuth access token using these credentials.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ── GG.deals (store price offers, optional) ───────────────────────────────────
# From https://gg.deals/affiliate/ — leave blank to disable store offers.
GGDEALS_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origin the browser frontend is served from. Default is used if omitted.
CORS_ALLOWED_ORIGIN=http://localhost:5173
