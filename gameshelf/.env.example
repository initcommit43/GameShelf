# Environment variable reference for Docker / CI / production deployments.
#
# For local development with Spring Boot, use local.properties instead —
# see local.properties.example for the template.
#
# In production, export these as real environment variables (or set them in
# your Docker Compose / Kubernetes manifest) and set SPRING_PROFILES_ACTIVE=prod.

SPRING_PROFILES_ACTIVE=prod

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://db:5432/gameshelf
DB_USERNAME=gameshelf
DB_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# ── IGDB (game data) ──────────────────────────────────────────────────────────
# Register at https://dev.twitch.tv — register an app under the IGDB category.
# The app fetches and auto-refreshes the OAuth access token using these credentials.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ── GG.deals (store price offers, optional) ───────────────────────────────────
# From https://gg.deals/affiliate/ — leave blank to disable.
GGDEALS_API_KEY=

# ── Upload URL ────────────────────────────────────────────────────────────────
# The public base URL the backend uses to build avatar URLs.
UPLOAD_BASE_URL=https://yourdomain.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origin the browser frontend is served from.
CORS_ALLOWED_ORIGIN=https://yourdomain.com
