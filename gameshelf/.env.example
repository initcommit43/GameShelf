# Copy this file to gameshelf/.env and fill in real values.
# Spring Boot loads it automatically — never commit .env (it is gitignored).

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev defaults shown; override for production
DB_URL=jdbc:postgresql://localhost:5432/gameshelf
DB_USERNAME=postgres
DB_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# At least 32 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# ── IGDB (game data) ──────────────────────────────────────────────────────────
# From https://api.igdb.com (Twitch developer portal)
IGDB_CLIENT_ID=
IGDB_ACCESS_TOKEN=

# ── GG.deals (store price offers, optional) ───────────────────────────────────
# From https://gg.deals/affiliate/ — leave blank to disable store offers
GGDEALS_API_KEY=
